{
  "name": "aurora-mind",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Aurora Mind \u2014 an advanced AI workspace that runs entirely in your browser, with four signature night modes.",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 5173",
    "typecheck": "tsc --noEmit",
    "test:smoke": "esbuild tests/smoke.tsx --bundle --platform=node --format=cjs --target=node18 --outfile=.scratch/smoke.cjs --loader:.css=empty --jsx=automatic --packages=external --define:process.env.NODE_ENV=\"development\" --log-level=warning && node .scratch/smoke.cjs",
    "test": "npm run typecheck && npm run test:smoke"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
